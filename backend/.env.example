# Copy to .env and adjust.
ENVIRONMENT=local
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# sqlite is fine to start; switch to Postgres (docker compose up -d db) when ready
DATABASE_URL=sqlite:///./crm.db
# DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
FIRST_OWNER_EMAIL=owner@example.com
FIRST_OWNER_PASSWORD=changethis123
DEFAULT_CURRENCY=INR

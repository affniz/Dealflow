# Copy to .env and adjust.
ENVIRONMENT=local
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://dealflow:dealflow@localhost:5432/dealflow
TEST_DATABASE_URL=postgresql+psycopg://dealflow:dealflow@localhost:5432/dealflow_test
REDIS_URL=redis://localhost:6379/0
# how often the worker looks for stalled deals
ROTTING_CHECK_INTERVAL_SECONDS=3600
FIRST_OWNER_EMAIL=owner@example.com
FIRST_OWNER_PASSWORD=changethis123
DEFAULT_CURRENCY=INR

# Copilot (Claude). Without a key the app works and Copilot says it isn't set up.
ANTHROPIC_API_KEY=
# default model and effort per agent; admins can change them in Settings
COPILOT_MODEL=claude-sonnet-5-5
COPILOT_EFFORT=medium
PIPELINE_MODEL=claude-sonnet-5-5
PIPELINE_EFFORT=medium
# the team's time zone, used when the AI talks about dates and times
TIMEZONE=Asia/Kolkata
# pipeline agent: daily review of stalled deals
PIPELINE_REVIEW_HOUR=7
PIPELINE_REVIEW_MAX_DEALS=20
PIPELINE_REVIEW_MAX_STEPS=5
PIPELINE_REVIEW_COOLDOWN_DAYS=3
# default monthly AI budgets in USD; admins change them, or remove a limit, in Settings
COPILOT_MONTHLY_BUDGET_USD=10
PIPELINE_MONTHLY_BUDGET_USD=20
